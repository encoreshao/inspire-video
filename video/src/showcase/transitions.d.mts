export type TBeat = {asset?: string; topic?: string; startFrame?: number; frames?: number};
export type Kind = 'first' | 'topic' | 'same';
export const XF_TOPIC: number;
export const XF_SAME: number;
export const XF_FIRST: number;
export const LABEL_DELAY: number;
export const LABEL_HOLD: number;
export const TOPIC_MAX_UNITS: number;
export const PIPS_MAX: number;
export const TOPIC_PATTERN: RegExp;
export function topicChanged(prev: TBeat | null | undefined, beat: TBeat): boolean;
export function transitionKind(prev: TBeat | null | undefined, beat: TBeat): Kind;
export function transitionLead(prev: TBeat | null | undefined, beat: TBeat): number;
export function leadsFor(beats: TBeat[]): number[];
export function incoming(frame: number, lead: number, kind: Kind): {opacity: number; scale: number; dy: number};
export function outgoing(frame: number, nextLead: number, kind: Kind): {scale: number; dy: number};
export function captionAlpha(t: number, toEnd: number, nextLead: number): {opacity: number; dy: number};
export function labelAlpha(t: number): number;
export function widthUnits(s: string): number;
export function topicValid(s: unknown): boolean;
export function progressLayout(beats: (TBeat & {startFrame: number; frames: number})[]): {mode: 'pips' | 'bar'; ticks: number[]; end?: number};
